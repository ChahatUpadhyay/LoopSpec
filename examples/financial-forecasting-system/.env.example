# Database
DATABASE_URL=sqlite:///./data/financial_forecasting.db

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Configuration
MODEL_PATH=data/models
DEFAULT_MODEL=xgboost

# Data Configuration
DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
NUM_STOCKS=500
YEARS_OF_DATA=10

# Backtesting Configuration
INITIAL_CAPITAL=100000
COMMISSION_PER_TRADE=0.001
SLIPPAGE_PERCENTAGE=0.0001

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
